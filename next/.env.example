# Postgres. Lokal: docker run -d --name palk3-pg -e POSTGRES_PASSWORD=palk3 -e POSTGRES_USER=palk3 -e POSTGRES_DB=palk3 -p 127.0.0.1:55433:5432 postgres:17-alpine
# Di Vercel diisi otomatis oleh integrasi Neon (DATABASE_URL pooled, DATABASE_URL_UNPOOLED langsung).
DATABASE_URL=postgres://palk3:palk3@127.0.0.1:55433/palk3
DATABASE_URL_UNPOOLED=

# Auth.js: openssl rand -base64 32
AUTH_SECRET=
# true di lokal/CI bila bukan https
AUTH_TRUST_HOST=true

# Vercel Blob (diisi otomatis saat store dihubungkan ke proyek)
BLOB_READ_WRITE_TOKEN=

# Seed: sandi akun demo (admin/pemantau/inspektur). Kosong = bawaan *123 untuk demo.
DEMO_MODE=true
DEMO_ADMIN_PASSWORD=
DEMO_PEMANTAU_PASSWORD=
DEMO_INSPEKTUR_PASSWORD=
# Sandi awal akun petugas contoh (NIP 1001..3002). Kosong = acak, dicetak sekali.
SEED_SANDI_AWAL=

# Vercel Cron (/api/cron/jadwal): Vercel mengirim "Authorization: Bearer $CRON_SECRET".
# openssl rand -hex 32. Kosong = rute cron menolak semua panggilan.
CRON_SECRET=

# Realtime (ADR K-12): Pusher Channels, aplikasi Sandbox klaster ap1. Kosong = realtime mati,
# klien memakai cache 2 menit + segarkan saat kembali ke aplikasi. Isi dari vault "pusher-pal-k3".
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1
# Hanya untuk peladen tiruan lokal (node e2e/realtime-tiruan.mjs): http://127.0.0.1:6001 dan ws://127.0.0.1:6001
PUSHER_HOST=
PUSHER_WS_URL=
