# Postgres. Lokal: docker run -d --name palk3-pg -e POSTGRES_PASSWORD=palk3 -e POSTGRES_USER=palk3 -e POSTGRES_DB=palk3 -p 127.0.0.1:55433:5432 postgres:17-alpine
# Di Vercel diisi otomatis oleh integrasi Neon (DATABASE_URL pooled, DATABASE_URL_UNPOOLED langsung).
DATABASE_URL=postgres://palk3:palk3@127.0.0.1:55433/palk3
DATABASE_URL_UNPOOLED=

# Auth.js: openssl rand -base64 32
AUTH_SECRET=
# true di lokal/CI bila bukan https
AUTH_TRUST_HOST=true

# Vercel Blob (diisi otomatis saat store dihubungkan ke proyek)
BLOB_READ_WRITE_TOKEN=

# Seed: sandi akun demo (admin/pemantau/inspektur). Kosong = bawaan *123 untuk demo.
DEMO_MODE=true
DEMO_ADMIN_PASSWORD=
DEMO_PEMANTAU_PASSWORD=
DEMO_INSPEKTUR_PASSWORD=
# Sandi awal akun petugas contoh (NIP 1001..3002). Kosong = acak, dicetak sekali.
SEED_SANDI_AWAL=

# Mode demo: akun demo (users.is_demo) boleh mengirim inspeksi dari luar kawasan galangan;
# masuk antrean tinjauan dengan alasan "Mode demo". Akun sungguhan tetap ditolak.
# Mati bila kosong. Isi 1 hanya untuk uji coba; hapus sebelum rilis. Lihat src/lib/geo/mode-demo.ts.
AKUN_DEMO_LEWATI_KAWASAN=

# Vercel Cron (/api/cron/jadwal): Vercel mengirim "Authorization: Bearer $CRON_SECRET".
# openssl rand -hex 32. Kosong = rute cron menolak semua panggilan.
CRON_SECRET=

# Realtime (ADR K-12): kunci API Ably "namaKunci:rahasia" (kapabilitas publish + subscribe).
# Kosong = realtime mati: cache 2 menit + segarkan saat kembali ke aplikasi. Isi dari vault "ably-palk3".
# REALTIME=mati mematikannya walau kunci ada.
ABLY_API_KEY=
REALTIME=
# Hanya untuk peladen tiruan lokal (node e2e/realtime-tiruan.mjs 6001): 127.0.0.1, 6001, 0
ABLY_ENDPOINT=
ABLY_PORT=
ABLY_TLS=
